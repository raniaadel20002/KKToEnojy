{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(site)/layout,_N_T_/[locale]/(site)/blogs/layout,_N_T_/[locale]/(site)/blogs/page,_N_T_/de/blogs"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/!KHNpdGUp/blogs/__PAGE__",
    "/$d$locale/!KHNpdGUp/blogs",
    "/$d$locale/!KHNpdGUp",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}