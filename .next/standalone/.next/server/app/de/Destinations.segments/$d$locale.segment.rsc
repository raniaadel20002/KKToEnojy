ount} Reise","destinationAlt":"Reiseziel {name}"}},"TripsPage":{"hero":{"subtitle":"Entdecken Sie unvergessliche Reisen, atemberaubende Reiseziele und unvergessliche Erlebnisse am Roten Meer und darüber hinaus.","title":"Ihre nächste Reise beginnt hier","imageAlt":"Ägypten Reisen Hero Banner"},"breadcrumb":{"home":"Startseite","explore":"Reisen","trips":"Reisen"},"toolbar":{"tripsFound":"{count} Reisen gefunden","tripFound":"{count} Reise gefunden","filter":"Filter","searchPlaceholder":"Suchen","showingCount":"Zeige {shown} von {total} Reisen","clearAll":"Alle Filter löschen"},"sidebar":{"filterTitle":"Filter","clearAll":"Alle Filter löschen","destination":"Reiseziel","anyDestination":"Beliebiges Reiseziel","priceRange":"Preisspanne","min":"Min","max":"Max","to":"Bis","tripsTypes":"Reisearten","allTrips":"Alle Reisen"},"grid":{"error":"Reisen konnten nicht geladen werden. Bitte versuche es später erneut.","noTripsTitle":"Keine Reisen gefunden","noTripsDescription":"Versuche deine Filter anzupassen, um mehr Ergebnisse zu sehen."},"mobileFilters":{"title":"Filter","applyButton":"Filter anwenden"},"showMore":{"loading":"Lädt...","button":"Mehr anzeigen"},"filters":{"tripType":"Reiseart","allTripTypes":"Alle Reisearten","destination":"Reiseziel","anyDestination":"Beliebiges Reiseziel","priceRange":"Preisspanne","setBudget":"Budget festlegen","minPrice":"Min preis","maxPrice":"Max preis","apply":"Anwenden","search":"Suchen","searchPlaceholder":"Reisen suchen...","showingCount":"Zeige {shown} von {total} Reisen","clearAll":"Alle Filter löschen","filterButton":"Filter"}},"GalleryPage":{"hero":{"subtitle":"Eine visuelle Sammlung unvergesslicher Reiseziele, atemberaubender Ausblicke und wunderschöner Momente aus unseren Reisen.","title":"Entdecke Ägypten durch unsere Linse","imageAlt":"Kamera mit Reisefotos"},"breadcrumb":{"home":"Startseite","gallery":"Galerie"},"states":{"loading":"Galerie wird geladen...","error":"Galeriebilder konnten nicht geladen werden.","empty":"Noch keine Bilder verfügbar."},"seeMore":"Mehr anzeigen"},"BlogsPage":{"hero":{"title":"Geschichten, die Ihre Reise inspirieren","subtitle":"Reiseinspirationen, lokale Einblicke und faszinierende Geschichten, die Ihnen helfen, mehr zu entdecken und jede Reise unvergesslich zu machen.","imageAlt":"Geschichten, die Ihre Reise inspirieren"},"breadcrumb":{"home":"Startseite","blogs":"Blog"},"search":{"placeholder":"Artikel, Reiseziele, Tipps suchen..."},"card":{"minRead":"Min. Lesezeit"},"grid":{"error":"Blogs konnten nicht geladen werden. Bitte versuche es später erneut.","empty":"Keine Artikel gefunden, die deiner Suche entsprechen.","seeMore":"Mehr anzeigen"}},"BlogDetails":{"breadcrumb":{"home":"Startseite","blogs":"Blog","details":"Blogdetails"},"share":{"title":"DIESE GESCHICHTE TEILEN","copyLink":"Link kopieren","copied":"Kopiert!","email":"E-Mail","share":"Teilen"},"inThisStory":"IN DIESER GESCHICHTE","recentPosts":{"title":"Neueste Beiträge"},"loading":"Blogdetails werden geladen...","error":"Blogbeitrag konnte nicht geladen werden.","backToBlogs":"Zurück zu Blogs"},"TripDetails":{"breadcrumb":{"home":"Startseite","trips":"Ausflüge","details":"Ausflugsdetails"},"about":{"title":"Über diesen Ausflug"},"keyInfo":{"duration":"Dauer","groupSize":"Gruppengröße","groupSizeValue":"2–15 Personen","availability":"Verfügbarkeit","daily":"Täglich","tourType":"Tour-Typ","historical":"Historisch"},"booking":{"adult":"Erwachsener","children":"Kinder (5–11 Jahre)","perPerson":"pro Person","checkAvailability":"Verfügbarkeit prüfen","contactUs":"Preis auf Anfrage"},"inclusions":{"title":"Was ist inbegriffen","included":"INBEGRIFFEN","notIncluded":"NICHT INBEGRIFFEN"},"highlights":{"title":"Tour-Highlights"},"reviews":{"title":"Bewertungen","basedOn":"Basierend auf {count} Bewertungen","noReviews":"Noch keine Bewertungen vorhanden.","addReview":"Bewertung hinzufügen","subtext":"Ihre E-Mail-Adresse wird nicht veröffentlicht. Pflichtfelder sind markiert *","yourRating":"Ihre Bewertung *","firstName":"Vorname *","lastName":"Nachname *","email":"E-Mail *","phone":"Telefon *","comment":"Kommentar *","placeholder":"Teilen Sie Ihre Erfahrungen mit dieser Tour...","submit":"Bewertung abschicken","submitting":"Wird gesendet...","success":"Vielen Dank! Ihre Bewertung wurde erfolgreich übermittelt.","error":"Bewertung konnte nicht übermittelt werden."}},"AboutPage":{"hero":{"subtitle":"Wir schaffen mit Leidenschaft außergewöhnliche Reiseerlebnisse in ganz Ägypten, persönlichen Service und echte Begeisterung dafür, Menschen die besuchten Orte näher zu bringen.","title":"Die Geschichte hinter Ihrer Reise","imageAlt":"Über uns Holzwürfel"},"breadcrumb":{"home":"Startseite","about":"Über uns"},"intro":{"title":"Jede Reise beginnt hier","description":"Wir vereinen das Beste aus Ägyptens Reiseerlebnissen, von den atemberaubenden Stränden und der lebendigen Unterwasserwelt des Roten Meeres bis hin zu aufregenden Wüstensafaris und unvergesslichen Kulturausflügen. Ob private Touren, Bootstouren, Flughafentransfers oder bequeme Reisedienstleistungen: Wir sind hier, um das Entdecken Ägyptens einfacher, angenehmer und unvergesslich zu machen."},"company":{"title":"Über unser Unternehmen","imageAlt":"Stadtansicht","description":"Wir haben uns darauf spezialisiert, unvergessliche Reiseerlebnisse in ganz Ägypten zu schaffen. Wir helfen Besuchern, die Schönheit des Roten Meeres zu entdecken, historische Ziele zu erkunden und authentische ägyptische Kultur zu erleben. Von Küstenabenteuern bis hin zu Wüstenausflügen bieten wir sorgfältig geplante Reisen und zuverlässige Tourismusdienstleistungen."},"mission":{"title":"Unsere Mission","imageAlt":"Reisende blickt in die Berge","description":"Unsere Mission ist es, jede Reise in Ägypten angenehm und mühelos zu gestalten, indem wir vertrauenswürdige Reisedienstleistungen, persönliche Unterstützung und unvergessliche Erlebnisse bieten. Unser Ziel ist es, jeden Reisenden mit den Reisezielen, Abenteuern und der Kultur zu verbinden, die Ägypten einzigartig machen."},"vision":{"title":"Unsere Vision","imageAlt":"Flugzeugfenster über den Wolken","description":"Unsere Vision ist es, ein vertrauenswürdiger Name im ägyptischen Tourismus zu werden und Besuchern sinnvolle Möglichkeiten zu bieten, das Rote Meer zu entdecken, Ägyptens reiches Erbe zu erkunden und seine bemerkenswerten Landschaften durch außergewöhnlichen Service und unvergessliche Reisen zu erleben."},"offers":{"title":"Was wir bieten","subtitle":"Erlebnisse, die Ihnen das Beste von Ägypten zeigen.","items":{"seaTrips":{"title":"Seereisen","description":"Bootstouren auf dem Roten Meer, Schnorcheln und wunderschöne Inseln."},"desertSafari":{"title":"Wüstensafari","description":"Wüstenabenteuer, Quadfahren und Beduinenleben entdecken."},"historicalTours":{"title":"Historische Touren","description":"Erkunden Sie antike Tempel, ikonische Wahrzeichen und ägyptische Geschichte."}}}},"ContactPage":{"hero":{"subtitle":"Kontakt aufnehmen","title":"Lass uns dein nächstes Abenteuer planen","description":"Haben Sie Fragen oder planen Sie Ihre nächste Reise? Unser Team hilft Ihnen gerne weiter, das perfekte Erlebnis zu finden und jede Reise unvergesslich zu machen.","imageAlt":"Kontakt Holzwürfel"},"breadcrumb":{"home":"Startseite","contact":"Kontakt"},"form":{"title":"Hast du Fragen? Schreib uns gerne","description":"Hast du eine Frage oder brauchst du weitere Informationen zu unseren Angeboten? Fülle das Formular aus, und wir melden uns so schnell wie möglich bei dir.","fields":{"name":{"label":"Dein Name","placeholder":"Namen eingeben"},"email":{"label":"E-Mail-Adresse","placeholder":"E-Mail eingeben"},"whatsapp":{"label":"WhatsApp-Nummer","placeholder":"Geben Sie Ihre WhatsApp-Nummer ein"},"message":{"label":"Nachricht","placeholder":"Schreibe deine Nachricht"}},"submit":"Nachricht senden"},"info":{"location":{"label":"Standort","value":"Hurghada, Rotes Meer, Ägypten"},"phone":{"label":"Ruf uns an"},"email":{"label":"E-Mail"}},"map":{"title":"Finden Sie uns auf der Karte"},"social":{"title":"Folge uns","links":{"facebook":"Facebook","instagram":"Instagram","tiktok":"TikTok","x":"X"}}},"CartPage":{"header":{"title":"Buchungswarenkorb","description":"Überprüfe deine ausgewählten Touren vor der Zahlung"},"loading":{"label":"Warenkorb wird geladen"},"item":{"remove":"Entfernen","removeAria":"{name} aus dem Warenkorb entfernen","travelers":"{count, plural, one {# Reisender} other {# Reisende}}","perPerson":"pro Person"},"summary":{"title":"Buchungsübersicht","empty":"Dein Warenkorb ist leer.","package":"Paket","adult":"Erwachsener","child":"Kind","total":"Gesamt","removeAria":"{name} aus der Buchungsübersicht entfernen","checkout":"Weiter zur Kasse →"},"empty":{"title":"Ihr Warenkorb ist derzeit leer","description":"Sieht so aus, als hätten Sie noch keine Reisen hinzugefügt. Entdecken Sie unsere neuesten Angebote und beginnen Sie mit der Planung Ihres nächsten Abenteuers!","button":"Reisen entdecken"}},"CheckoutPage":{"empty":{"title":"Dein Warenkorb ist leer","description":"Bitte gehe zurück und wähle eine Reise aus, die du buchen möchtest.","cta":"Reisen entdecken"},"form":{"billing":{"title":"Rechnungsdetails","fields":{"firstName":{"label":"Vorname *","placeholder":"Vorname"},"lastName":{"label":"Nachname *","placeholder":"Nachname"},"nationality":{"label":"Nationalität *","placeholder":"Nationalität auswählen (z. B. EG, US, GB)"},"email":{"label":"E-Mail-Adresse *","placeholder":"E-Mail-Adresse"},"phone":{"label":"Telefonnummer *","placeholder":"Telefonnummer"},"hotelName":{"label":"Hotelname (Optional)","placeholder":"Hotelname"},"roomNo":{"label":"Zimmernummer (Optional)","placeholder":"Zimmernummer"}}},"coupon":{"title":"Gutschein","placeholder":"Gutscheinnummer eingeben","apply":"Anwenden","applying":"Wird angewendet...","success":"Gutschein angewendet! Du sparst {amount}","invalid":"Ungültiger Gutscheincode"},"payment":{"title":"Zahlungsmethode","bookNowPayLater":"Jetzt buchen, später bezahlen"},"