{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(site)/layout,_N_T_/[locale]/(site)/Destinations/layout,_N_T_/[locale]/(site)/Destinations/page,_N_T_/de/Destinations"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/!KHNpdGUp/Destinations/__PAGE__",
    "/$d$locale/!KHNpdGUp/Destinations",
    "/$d$locale/!KHNpdGUp",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}