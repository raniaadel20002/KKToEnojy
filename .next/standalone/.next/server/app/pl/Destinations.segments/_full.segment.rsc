7:["$","$L18",null,{"formats":"$undefined","locale":"pl","messages":{"NotFound":{"title":"404","subtitle":"Nie znaleziono strony","description":"Ups! Strona, której szukasz, nie istnieje, została usunięta lub jest tymczasowo niedostępna.","backToHome":"Wróć do strony głównej"},"Header":{"logoHome":"Strona główna Logoipsum","openCart":"Otwórz koszyk","openMenu":"Otwórz menu","closeMenu":"Zamknij menu"},"LocaleSwitcher":{"label":"Zmień język","english":"Angielski","french":"Francuski","german":"Niemiecki","polish":"Polski"},"Navigation":{"home":"Strona główna","destinations":"Destynacje","trips":"Wycieczki","gallery":"Galeria","blogs":"Blog","about":"O nas","contact":"Kontakt","faq":"FAQ","allDestinations":"Wszystkie destynacje"},"Hero":{"ariaLabel":"Polecane wycieczki do Egiptu","cta":"Poznaj nasze doświadczenia","controls":{"previousSlide":"Poprzedni slajd","nextSlide":"Następny slajd"},"destinationCards":{"view":"Zobacz {destination}"},"destinations":{"redSea":"Morze Czerwone","luxor":"Luksor","giza":"Giza"},"slides":{"boat":{"subtitle":"Odkryj","title":"Każda podróż ma swoją historię. Zacznij swoją w Egipcie.","description":"Od złotych wydm Sahary po tętniące życiem rafy koralowe Morza Czerwonego — odkryj niezapomniane przygody stworzone dla każdego podróżnika."},"sunset":{"subtitle":"Odkryj","title":"Gdzie każdy zachód słońca opowiada starożytną historię","description":"Patrz, jak złote zachody słońca malują Saharę i Nil odcieniami bursztynu i różu, i pozwól, by ponadczasowe piękno Egiptu pozostawiło wrażenie na całe życie."},"prim":{"subtitle":"Odkryj","title":"Przemierz tysiące lat historii","description":"Stań przed majestatycznymi Piramidami, odkryj starożytne tajemnice, popłyń Nilem i doświadcz ponadczasowych cudów, które od wieków inspirują podróżników."}},"eyebrow":"TWOJA NASTĘPNA PRZYGODA CZEKA","title":"Odkryj Egipt","description1":"Krystalicznie czysta woda, zapierające dech w piersiach krajobrazy i niezapomniane przeżycia.","description2":"Odkrywaj Egipt i nie tylko z nami.","features":{"amazingDestinations":{"title":"Niesamowite","subtitle":"Destynacje"},"safeReliable":{"title":"Bezpieczne i Niezawodne","subtitle":"Usługi"},"localExperts":{"title":"Lokalni Eksperci","subtitle":"i Przewodnicy"},"unforgettable":{"title":"Niezapomniane","subtitle":"Doświadczenia"}}},"Categories":{"subtitle":"Poznaj nasze doświadczenia podróżnicze i usługi na każdą podróż.","title":"Kategorie","loading":"Ładowanie destynacji...","error":"Nie udało się załadować destynacji","goTo":"Przejdź do {destination}","exploreTrips":"Odkryj wycieczki","viewAll":"Zobacz wszystkie kategorie"},"Tours":{"subtitle":"Znajdź swój kolejny ulubiony cel podróży spośród naszych najlepszych propozycji.","title":"Bestsellerowe wycieczki","allTours":"Wszystkie wycieczki","viewMore":"Zobacz więcej","loadingFilters":"Ładowanie filtrów...","loadingTours":"Ładowanie wycieczek...","noTours":"Brak dostępnych wycieczek w tej chwili.","bookNow":"Zarezerwuj teraz","addToCart":"Dodaj do koszyka","addedToCart":"Wycieczka dodana do koszyka!","tripSuccessfullyBooked":"Wycieczka pomyślnie zarezerwowana","addedSuccess":"została dodana do Twojego koszyka.","viewCart":"Zobacz koszyk","continueBrowsing":"Kontynuuj przeglądanie"},"PopularDestinations":{"subtitle":"Kolekcja niezwykłych miejsc, z których każde ma swój własny urok i historię.","title":"Popularne destynacje","viewMore":"Zobacz więcej","loading":"Ładowanie popularnych destynacji...","exploreTrips":"Odkryj wycieczki","trips":"{count} wycieczki","tripsSingular":"{count} wycieczka"},"HowItWorks":{"subtitle":"Twoja podróż stała się prosta, od pierwszego kroku do celu","title":"Jak to działa","steps":{"step1":{"title":"Wybierz doświadczenie","description":"Przeglądaj przygody dopasowane do Twojego stylu podróżowania."},"step2":{"title":"Zarezerwuj bezpiecznie","description":"Zarezerwuj bezpiecznie za pomocą zaufanych metod płatności."},"step3":{"title":"Otrzymaj potwierdzenie","description":"Twój itineriusz dotrze natychmiast na Twoją skrzynkę pocztową."},"step4":{"title":"Ciesz się podróżą","description":"Spakuj walizki — my zajmiemy się resztą."}}},"Gallery":{"subtitle":"Chwile uchwycone przez naszych podróżników w całym Egipcie.","title":"Nasza galeria","loading":"Ładowanie galerii...","prev":"Poprzednie zdjęcie","next":"Następne zdjęcie"},"Blogs":{"subtitle":"Historie, wskazówki i inspiracje z najbardziej kultowych miejsc w Egipcie.","title":"Nasze blogi","viewMore":"Zobacz wszystkie artykuły","readMore":"Czytaj więcej","minRead":"min czytania","error":"Nie udało się załadować blogów. Spróbuj ponownie później.","empty":"Wygląda na to, że ta sekcja jest na razie pusta."},"Explore":{"title":"Tutaj zaczyna się Twoja przygoda","description":"Wybierz spośród najbardziej ekscytujących doświadczeń podróżniczych w Egipcie.","cta":"Odkryj wycieczki teraz"},"FAQ":{"subtitle":"Wszystko, co musisz wiedzieć przed swoją podróżą.","title":"FAQ","viewAll":"Zobacz wszystkie artykuły"},"Footer":{"companyDescription":"Odkryj piękno Egiptu dzięki spersonalizowanym wycieczkom i usługom turystycznym dopasowanym do Twojego stylu życia, harmonogramu i budżetu.","quickLinks":"Szybkie linki","quickAction":"Szybkie linki","contactUs":"Skontaktuj się z nami","followUs":"Obserwuj nas","address":"El Kawther, Hurghada, Egipt","poweredBy":"Obsługiwane przez","allRightsReserved":"Wszelkie prawa zastrzeżone"},"DestinationsPage":{"hero":{"subtitle":"Odkryj najlepsze miejsca do odwiedzenia w Egipcie, od zachwycającego wybrzeża Morza Czerwonego i pięknych wysp po urokliwe miasta nadmorskie i zapierające dech w piersiach krajobrazy.","title":"Odkryj najpiękniejsze destynacje w Egipcie","imageAlt":"Baner destynacji w Egipcie"},"breadcrumb":{"home":"Strona główna","destinations":"Destynacje"},"card":{"trips":"{count} wycieczki","tripsSingular":"{count} wycieczka","destinationAlt":"Destynacja {name}"}},"TripsPage":{"hero":{"subtitle":"Odkryj niezapomniane wycieczki, zapierające dech w piersiach destynacje i niezapomniane przeżycia nad Morzem Czerwonym i nie tylko.","title":"Twoja kolejna podróż zaczyna się tutaj","imageAlt":"Baner wycieczek po Egipcie"},"breadcrumb":{"home":"Strona główna","explore":"Wycieczki","trips":"Wycieczki"},"toolbar":{"tripsFound":"Znaleziono {count} wycieczki","tripFound":"Znaleziono {count} wycieczkę","filter":"Filtruj","searchPlaceholder":"Szukaj","showingCount":"Wyświetlanie {shown} z {total} wycieczek","clearAll":"Wyczyść wszystkie filtry"},"sidebar":{"filterTitle":"Filtruj","clearAll":"Wyczyść wszystkie filtry","destination":"Destynacja","anyDestination":"Dowolna destynacja","priceRange":"Przedział cenowy","min":"Min","max":"Maks","to":"Do","tripsTypes":"Rodzaje wycieczek","allTrips":"Wszystkie wycieczki"},"grid":{"error":"Nie udało się załadować wycieczek. Spróbuj ponownie później.","noTripsTitle":"Nie znaleziono wycieczek","noTripsDescription":"Spróbuj dostosować filtry, aby zobaczyć więcej wyników."},"mobileFilters":{"title":"Filtry","applyButton":"Zastosuj filtry"},"showMore":{"loading":"Ładowanie...","button":"Pokaż więcej"},"filters":{"tripType":"Typ wycieczki","allTripTypes":"Wszystkie typy","destination":"Cel podróży","anyDestination":"Dowolny cel podróży","priceRange":"Zakres cen","setBudget":"Ustal swój budżet","minPrice":"Cena min","maxPrice":"Cena max","apply":"Zastosuj","search":"Szukaj","searchPlaceholder":"Szukaj wycieczek...","showingCount":"Wyświetlanie {shown} z {total} wycieczek","clearAll":"Wyczyść wszystkie filtry","filterButton":"Filtruj"}},"GalleryPage":{"hero":{"subtitle":"Wizualna kolekcja niezapomnianych miejsc, zapierających dech w piersiach widoków i pięknych chwil z naszych podróży.","title":"Odkryj Egipt przez nasz obiektyw","imageAlt":"Aparat fotograficzny ze zdjęciami z podróży"},"breadcrumb":{"home":"Strona główna","gallery":"Galeria"},"states":{"loading":"Ładowanie galerii...","error":"Nie udało się załadować zdjęć galerii.","empty":"Brak dostępnych zdjęć."},"seeMore":"Zobacz więcej"},"BlogsPage":{"hero":{"title":"Historie, które inspirują Twoją podróż","subtitle":"Inspiracje podróżnicze, lokalne ciekawostki i fascynujące historie, które pomogą Ci odkryć więcej i uczynić każdą podróż niezapomnianą.","imageAlt":"Historie, które inspirują Twoją podróż"},"breadcrumb":{"home":"Strona główna","blogs":"Blogi"},"search":{"placeholder":"Szukaj artykułów, kierunków, wskazówek..."},"card":{"minRead":"min czytania"},"grid":{"error":"Nie udało się załadować blogów. Spróbuj ponownie później.","empty":"Nie znaleziono artykułów pasujących do wyszukiwania.","seeMore":"Zobacz więcej"}},"BlogDetails":{"breadcrumb":{"home":"Strona główna","blogs":"Blogi","details":"Szczegóły wpisu"},"share":{"title":"UDOSTĘPNIJ TĘ HISTORIĘ","copyLink":"Kopiuj link","copied":"Skopiowano!","email":"E-mail","share":"Udostępnij"},"inThisStory":"W TYM ARTYKULE","recentPosts":{"title":"Najnowsze wpisy"},"loading":"Ładowanie szczegółów wpisu...","error":"Nie udało się załadować wpisu.","backToBlogs":"Wróć do blogów"},"TripDetails":{"breadcrumb":{"home":"Strona główna","trips":"Wycieczki","details":"Szczegóły wycieczki"},"about":{"title":"O tej wycieczce"},"keyInfo":{"duration":"Czas trwania","groupSize":"Wielkość grupy","groupSizeValue":"2–15 osób","availability":"Dostępność","daily":"Codziennie","tourType":"Typ wycieczki","historical":"Historyczna"},"booking":{"adult":"Dorosły","children":"Dzieci (5–11 lat)","perPerson":"za osobę","checkAvailability":"Sprawdź dostępność","contactUs":"Skontaktuj się w sprawie ceny"},"inclusions":{"title":"Co jest w cenie","included":"W CENIE","notIncluded":"NIE WLICZONE"},"highlights":{"title":"Atrakcje wycieczki"},"reviews":{"title":"Opinie","basedOn":"Na podstawie {count} opinii","noReviews":"Brak opinii.","addReview":"Dodaj opinię","subtext":"Twój adres e-mail nie zostanie opublikowany. Wymagane pola są oznaczone *","yourRating":"Twoja ocena *","firstName":"Imię *","lastName":"Nazwisko *","email":"E-mail *","phone":"Telefon *","comment":"Opinia *","placeholder":"Podziel się wrażeniami z tej wycieczki...","submit":"Wyślij opinię","submitting":"Wysyłanie...","success":"Dziękujemy! Twoja opinia została pomyślnie przesłana.","error":"Nie udało się przesłać opinii."}},"AboutPage":{"hero":{"subtitle":"Z pasją tworzymy wyjątkowe doświadczenia podróżnicze w całym Egipcie, zapewniając spersonalizowaną obsługę i autentyczną miłość do przybliżania ludziom odwiedzanych miejsc.","title":"Historia Twojej podróży","imageAlt":"Drewniane klocki o nas"},"breadcrumb":{"home":"Strona główna","about":"O nas"},"intro":{"title":"Każda podróż zaczyna się tutaj","description":"Łączymy to, co najlepsze w egipskich doświadczeniach turystycznych — od zachwycających plaż i tętniącego życiem podwodnego świata Morza Czerwonego, po ekscytujące safari pustynne i niezapomniane wycieczki kulturalne. Niezależnie od tego, czy szukasz prywatnych wycieczek, rejsów łodzią, transferów lotniskowych czy wygodnych usług turystycznych, jesteśmy tutaj, aby uczynić odkrywanie Egiptu łatwiejszym, przyjemniejszym i naprawdę niezapomnianym."},"company":{"title":"O naszej firmie","imageAlt":"Widok na budynki miejskie","description":"Specjalizujemy się w tworzeniu niezapomnianych wrażeń z podróży po całym Egipcie, pomagając turystom odkrywać piękno Morza Czerwonego, zwiedzać zabytkowe miejsca i poznawać autentyczną kulturę egipską. Od nadmorskich przygód po wyprawy na pustynię — oferujemy starannie zaplanowane wycieczki i niezawodne usługi turystyczne."},"mission":{"title":"Nasza misja","imageAlt":"Podróżniczka spoglądająca na góry","description":"Naszą misją jest uczynienie każdej podróży po Egipcie przyjemną i bezproblemową poprzez świadczenie zaufanych usług turystycznych, spersonalizowaną pomoc i niezapomniane wrażenia. Naszym celem jest łączenie każdego podróżnika z miejscami, przygodami i kulturą, które czynią Egipt wyjątkowym."},"vision":{"title":"Nasza wizja","imageAlt":"Okno samolotu ponad chmurami","description":"Naszą wizją jest stać się zaufaną marką w egipskiej turystyce, oferując gościom wartościowe sposoby na odkrywanie Morza Czerwonego, poznawanie bogatego dziedzictwa Egiptu i doświadczanie jego niezwykłych krajobrazów dzięki wyjątkowej obsłudze i niezapomnianym podróżom."},"offers":{"title":"Co oferujemy","subtitle":"Doświadczenia zaprojektowane tak, aby pokazać Ci to, co w Egipcie najlepsze.","items":{"seaTrips":{"title":"Wycieczki morskie","description":"Rejsy po Morzu Czerwonym, snorkeling i piękne wyspy."},"desertSafari":{"title":"Safari na pustyni","description":"Przygody na pustyni, jazda na quadach i życie Beduinów."},"historicalTours":{"title":"Wycieczki historyczne","description":"Odkrywaj starożytne świątynie, kultowe zabytki i historię Egiptu."}}}},"ContactPage":{"hero":{"subtitle":"Skontaktuj się z nami","title":"Zacznijmy Twoją następną przygodę","description":"Masz pytania lub planujesz kolejną podróż? Nasz zespół jest tutaj, aby Ci doradzić, pomóc wybrać idealne doświadczenie i uczynić każdą podróż niezapomnianą.","imageAlt":"Drewniane klocki kontakt"},"breadcrumb":{"home":"Strona główna","contact":"Kontakt"},"form":{"title":"Masz pytania? Napisz do nas","description":"Masz pytanie lub potrzebujesz więcej informacji o naszych produktach? Wypełnij poniższy formularz, a odezwiemy się jak najszybciej.","fields":{"name":{"label":"Twoje imię","placeholder":"Wpisz imię"},"email":{"label":"Adres e-mail","placeholder":"Wpisz e-mail"},"whatsapp":{"label":"Numer WhatsApp","placeholder":"Wpisz swój numer WhatsApp"},"message":{"label":"Wiadomość","placeholder":"Napisz swoją wiadomość"}},"submit":"Wyślij wiadomość"},"info":{"location":{"label":"Lokalizacja","value":"Hurghada, Morze Czerwone, Egipt"},"phone":{"label":"Zadzwoń do nas"},"email":{"label":"E-mail"}},"map":{"title":"Znajdź nas na mapie"},"social":{"title":"Obserwuj nas","links":{"facebook":"Facebook","instagram":"Instagram","tiktok":"TikTok","x":"X"}}},"CartPage":{"header":{"title":"Koszyk rezerwacji","description":"Sprawdź wybrane wycieczki przed płatnością"},"loading":{"l