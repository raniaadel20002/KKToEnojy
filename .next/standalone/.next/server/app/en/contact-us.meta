{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(site)/layout,_N_T_/[locale]/(site)/contact-us/layout,_N_T_/[locale]/(site)/contact-us/page,_N_T_/en/contact-us"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/!KHNpdGUp/contact-us/__PAGE__",
    "/$d$locale/!KHNpdGUp/contact-us",
    "/$d$locale/!KHNpdGUp",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}