7:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TravelAgency\",\"@id\":\"https://kktoenjoy.com/#organization\",\"name\":\"KKToEnojy\",\"alternateName\":[\"KK To Enjoy\",\"KKTOENJOY\",\"KKToEnojy Tours\",\"KKToEnojy Egypt\"],\"url\":\"https://kktoenjoy.com\",\"logo\":\"https://kktoenjoy.com/Hero/logo.png\",\"image\":\"https://kktoenjoy.com/og-image.jpg\",\"description\":\"KKToEnojy is a premier Egyptian tour operator offering guided excursions, desert safaris, Red Sea water sports, and historical tours across Cairo, Luxor, and Hurghada.\",\"telephone\":\"+20 100 000 0000\",\"email\":\"info@KKToEnojy.com\",\"priceRange\":\"$$\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Hurghada / Red Sea, Egypt\",\"addressCountry\":\"EG\"},\"sameAs\":[\"https://www.facebook.com/kktoenojy\",\"https://www.instagram.com/kktoenojy\",\"https://www.tiktok.com/@kktoenojy\",\"https://x.com/kktoenojy\",\"https://wa.me/201000000000\"]}"}}],"$L1b"]
