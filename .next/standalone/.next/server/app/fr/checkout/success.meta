    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(site)/layout,_N_T_/[locale]/(site)/checkout/layout,_N_T_/[locale]/(site)/checkout/success/layout,_N_T_/[locale]/(site)/checkout/success/page,_N_T_/fr/checkout/success"
  },
  "segmentPaths": [
