    "/$d$locale/!KHNpdGUp/checkout/success/__PAGE__",
    "/$d$locale/!KHNpdGUp/checkout/success",
    "/$d$locale/!KHNpdGUp/checkout",
    "/$d$locale/!KHNpdGUp",
