{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(site)/layout,_N_T_/[locale]/(site)/gallery/layout,_N_T_/[locale]/(site)/gallery/page,_N_T_/fr/gallery"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/!KHNpdGUp/gallery/__PAGE__",
    "/$d$locale/!KHNpdGUp/gallery",
    "/$d$locale/!KHNpdGUp",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}